{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/sample_data/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/storage/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/SatQuery_AI_Complete_Features_Guide.pdf",
      "dest": "api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ]
}
